# Copy to .env. docker-compose overrides DATABASE_URL/REDIS_URL/PORT for the container.
PORT=3001
NODE_ENV=development
DATABASE_URL=postgres://learnos:learnos@localhost:5432/learnos
TEST_DATABASE_URL=postgres://learnos:learnos@localhost:5432/learnos_test
REDIS_URL=redis://localhost:6379
NVIDIA_API_KEY=
# Override only to point at a different OpenAI-compatible endpoint.
# NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# Comma-separated origins allowed by CORS (web app + extension in dev)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Where /auth/verify sends the browser after setting the session cookie
APP_URL=http://localhost:3000

# SMTP. Leave SMTP_HOST empty to print magic links to the console instead of
# sending them — that is the default for dev and the only behaviour under test.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM=learnos <no-reply@example.com>
