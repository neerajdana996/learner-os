{
  "name": "learner-os-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=20" },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json && node scripts/copy-assets.mjs",
    "start": "node dist/index.js",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:push": "drizzle-kit push",
    "db:test:push": "cross-env DATABASE_URL=${TEST_DATABASE_URL:-postgres://learnos:learnos@localhost:5432/learnos_test} drizzle-kit push",
    "seed": "tsx src/scripts/seed.ts",
    "qa": "tsx src/scripts/qa.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.52.0",
    "bullmq": "^5.44.0",
    "cors": "^2.8.5",
    "drizzle-orm": "^0.44.0",
    "express": "^5.1.0",
    "ioredis": "^5.6.1",
    "postgres": "^3.4.5",
    "ts-fsrs": "^4.6.1",
    "ws": "^8.18.2",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.1",
    "@types/node": "^22.15.0",
    "@types/ws": "^8.18.1",
    "cross-env": "^7.0.3",
    "drizzle-kit": "^0.31.0",
    "supertest": "^7.1.0",
    "@types/supertest": "^6.0.3",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitest": "^3.1.3"
  }
}
